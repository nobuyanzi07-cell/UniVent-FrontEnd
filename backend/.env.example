# Copy this file to .env and fill in your own values. Never commit .env.

# development | testing | production
FLASK_ENV=development
SECRET_KEY=change-me

# Local database. SQLite works with no setup; use Postgres to match production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/univent
DATABASE_URL=sqlite:///univent.db

# Frontends allowed to call the API (comma-separated, no trailing slash)
FRONTEND_URLS=http://localhost:5173

# Optional: Ticketmaster key for /api/featured (kept on the server, never in React)
TICKETMASTER_API_KEY=
